PORT=3001
MONGODB_URI=mongodb://localhost:27017/eldermin
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
ANTHROPIC_API_KEY=your_key_here
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# At-rest encryption for stored third-party OAuth tokens (e.g. QuickBooks) -
# any string works, a proper key is derived from it via scrypt.
ENCRYPTION_KEY=change_me_to_a_long_random_string

# QuickBooks Online (developer.intuit.com -> My Apps -> Keys & OAuth)
BACKEND_URL=http://localhost:3001
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox

# Google Analytics (GA4) - powers Super Admin > Analytics & Reports >
# Website Visitor Metrics. GA4_PROPERTY_ID is the numeric Property ID from
# GA Admin > Property Settings (not the "G-XXXXXXXXXX" Measurement ID -
# that one goes on the frontend as VITE_GA4_MEASUREMENT_ID instead).
# GA4_SERVICE_ACCOUNT_KEY is the full JSON contents (as one string) of a
# Google Cloud service account key that has been (1) granted access to the
# "Google Analytics Data API" in its GCP project and (2) added as a Viewer
# on the GA4 property itself (GA Admin > Property Access Management, using
# the service account's own @....iam.gserviceaccount.com email). Leave both
# unset to leave this widget showing "not configured" rather than erroring.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_KEY=

# Guard rollout switches (log = write a structured would-deny line and let the request through; enforce = 403). Defaults: log.
# BEHAVIOUR_GUARD_MODE=log
# CUSTOM_ROLE_GUARD_MODE=log
# TEACHER_SCOPE_GUARD_MODE=log
# NON_STAFF_GUARD_MODE=log
# Account-state check on every token (user active + tokenVersion + school not suspended + staff not deactivated). Kill switch: AUTH_STATE_CHECK=off
# AUTH_STATE_CHECK=on
